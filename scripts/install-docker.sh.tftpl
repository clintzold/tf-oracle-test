#!/bin/bash
# Runs once, as root, on first boot (cloud-init). Log: /var/log/cloud-init-output.log
set -euxo pipefail

# Install podman and companion container utlities
dnf install -y container-tools

# Open the LDAP port in the VM's own firewall (separate from the OCI security list)
firewall-cmd --permanent --add-port=${ldap_port}/tcp
firewall-cmd --reload

# Pull and run simple LDAP service container
podman run -d --name ldap --restart unless-stopped -p ${ldap_port}:389 -e LDAP_ORGANISATION=Test -e LDAP_DOMAIN=example.org -e LDAP_ADMIN_PASSWORD=changeme docker.io/osixia/openldap:1.5.0

# Make sure restart service is enabled for podman (unlike docker, podman has no background daemon)
systemctl enable --now podman-restart.service
